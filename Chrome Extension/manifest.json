{
  "manifest_version": 3,
  "name": "LeetCode to GitHub",
  "version": "0.1.0",
  "description": "Automatically commits accepted LeetCode solutions to a GitHub repository.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["intercept.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "LeetCode to GitHub (click for settings)",
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
